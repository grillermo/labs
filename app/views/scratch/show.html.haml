%section#scratch.container
  .info-box
    %p.scratch-label
      Scratch #{@scratch.id}
    - if scratch_is_link?(@scratch)
      %p
        = link_to(@scratch.content, @scratch.content, target: '_blank')
    - elsif scratch_has_link_words?(@scratch)
      %p= render_scratch_content_with_links(@scratch)
    - else
      %p= @scratch.content

  .input-box
    = form_for @scratch do |f|
      .grow-wrap{"data-replicated-value" => @scratch.content}
        = f.text_area :content, value: @scratch.content, placeholder: 'Type here...'
      = f.hidden_field :id, value: @scratch.id
      .scratch-actions
        = f.submit 'Save'

:javascript
  const scratchContent = $("#scratch_content");

  const syncScratchContent = function() {
    this.parentNode.dataset.replicatedValue = this.value;
  };

  scratchContent.each(function() {
    syncScratchContent.call(this);
  }).focus().select();

  $(document).on('input', '#scratch_content', function() {
    syncScratchContent.call(this);
  });

  $(document).on('keydown', '#scratch_content', function(e) {
    if(e.keyCode == 13 && (e.metaKey || e.ctrlKey)) {
      $(this).parents('form').submit()
    }
  });
